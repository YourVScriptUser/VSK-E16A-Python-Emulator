; === function main ===
main:
PUSH r15
MOVFS r15, rSP
MOV r0, 1
PUSH r0
CALL PrintDec
POP r6
MOV r0, 0
JMP L_main_epilogue_25
L_main_epilogue_25:
MOVSP r15
POP r15
RET

; === function PrintDec ===
PrintDec:
PUSH r15
MOVFS r15, rSP
MOV r0, L_str_27
PUSH r0
MOV r4, 2
ADD r15, r4, r3
MOV r0, [r3]
PUSH r0
MOV r0, 1
PUSH r0
CALL __printf
POP r6
POP r6
POP r6
MOV r0, 0
JMP L_PrintDec_epilogue_26
L_PrintDec_epilogue_26:
MOVSP r15
POP r15
RET


; === data region: globals ===
