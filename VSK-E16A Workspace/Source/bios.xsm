; STRINGS //
 
; Emulator colors:
; 130: RED
; 131: GREEN
; 132: BLUE
; 133: GREY
; 134: CYAN
; 135: BACKGROUND RED
; 136: RESET
 
STRING_BIOS_BANNER:
%defineword 134, "VSK sysROM BIOS v1.5.2", 10
%defineword      "VSK-E16A PROPRIETARY ROM BIOS", 10, 10
%defineword      "Copyright (c) VSK Software 2026. All rights reserved.", 136, 0
 
STRING_HARDWARE_INIT:
%defineword 133, "Initializing hardware...", 0
 
STRING_INTERRUPT_INIT:
%defineword 133, "Initializing interrupts...", 0
 
STRING_BOOT_INIT:
%defineword 133, "Reading boot tables...", 0
 
STRING_K_SUFFIX:
%defineword 133, "K", 0
 
STRING_DONE:
%defineword 133, " done", 0
 
STRING_NOT_PRESENT:
%defineword 133, " not present", 0
 
STRING_MEM_TEST:
%defineword 133, "Press any key to skip memory test", 10, "Memory Test... ", 0
 
STRING_NO_OS:
%defineword 130, "Bootable operating system not found.", 133, 10, 10
%defineword      "Press enter to continue", 0
 
STRING_OS:
%defineword 133, "OS found: ", 0
 
STRING_INFO:
%defineword 134, "INTERRUPT VECTOR TABLE   ",     10
%defineword      "-----------------------  ",     10
%defineword 133, "VECTOR  TYPE   FUNCTION  ",     10
%defineword      "01      SW     CLR KBUF  ",     10
%defineword      "02      SW     CLR VIDEO ",     10
%defineword      "0E      SW     TTY OUT   ",     10
%defineword      "0F      SW     WAIT ENTER",     10
%defineword      "10      SW     DISK READ ",     10
%defineword      "11      SW     DISK WRITE",     10
%defineword      "12      SW     POWER CYCL",     10
%defineword      "EF      HW     KEYBOARD  ",     10
%defineword      "FF      HW     GPF       ",     10,10
 
%defineword 134, "IO  DEVICES      ", 10
%defineword      "-----------------", 10
%defineword 133, "PORT      DEVICE ", 10
%defineword      "1         STORAGE", 10
%defineword      "2         POWER MGR"
 
%defineword 10, 10
%defineword 134, "BIOS MEMORY ALLOCATION",                   133, 10
%defineword      "[0x0000+0x10FF] BIOS RESERVED ",           10
%defineword      "[0x10FF+0xDF00] FREE          ",           10
%defineword      "[0xF000+0x009B] KEYBOARD      ",           10
%defineword      "[0xF100+0x0F00] VIDEO         ",           10,10,10

%defineword 131, "Copyright (c) VSK software 2026. All rights reserved.", 0
 
%defineword 136, 0


STRING_AT:
  %defineword " at ", 0

STRING_QUOTE:
  %defineword 39, 0

STRING_ISR_KBUF:
  %defineword 133, "  ISR 0x01 (clrkbf)............", 0

STRING_ISR_VBUF:
  %defineword 133, "  ISR 0x02 (clrvbf)............", 0

STRING_ISR_TTY:
  %defineword 133, "  ISR 0x0E (tty)...............", 0

STRING_ISR_AWAIT:
  %defineword 133, "  ISR 0x0F (pause).............", 0

STRING_ISR_DISKR:
  %defineword 133, "  ISR 0x10 (disk read).........", 0

STRING_ISR_DISKW:
  %defineword 133, "  ISR 0x11 (disk write)........", 0

STRING_ISR_PWR:
  %defineword 133, "  ISR 0x12 (powercfg)..........", 0

STRING_ISR_FAIL:
