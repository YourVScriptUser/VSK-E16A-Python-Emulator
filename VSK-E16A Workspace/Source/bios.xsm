; MARKERS //
%region 0xEFFF
;$$far
; Address of the keyboard buffer pointer
KBUF_CURSOR:
 
%region 0xF000
;$$far
; Where the keyboard buffer starts
KBUF_BASE:
 
%region 155
;$$far
; Size of the keyboard buffer
KBUF_SIZE:
 
%region 0x10EE
;$$far
; BIOS stack space base pointer
BIOS_STACK_BASE:
 
%region 0x00EF
;$$far
; Keyboard hardware interrupt ISR number
; Mapped by the emulator
KB_INTERRUPT_VECTOR:
 
%region 0xF100
;$$far
; Points to the start address of video ram
VIDEO_MEMORY_BASE:
 
%region 0x1100
;$$far
; Points to the start of the BMT table
BMT_TABLE_ADDRESS:
 
%region 0x1101
;$$far
; Points to the location of the entrypoint in the BMT table (if it exists)
BMT_TABLE_ENTRYPOINT_ADDRESS:
 
%region 0x1102
;$$far
; Points to the location of the OS string name in the BMT table (if it exists)
BMT_TABLE_STRING_ADDRESS: