; === vskcc generated program ===
; boot: set up stack pointer, then jump to compiled main()
%REGION 0x2000
MOV r14, 61440
MOVSP r14
MOV r0, 0
CALL main
HLT

; === __printf(argcount, fmt_addr, args...) runtime ===
; scans fmt for % specifiers, consuming one stack arg per specifier
__printf:
PUSH r15
MOVFS r15, rSP
MOV r0, 0
PUSH r0
PUSH r0
PUSH r0
; argcount is always at r15+2 (pushed last, closest to return addr)
MOV r1, 2
ADD r15, r1, r2
MOV r3, [r2]
PUSH r3
; compute the ADDRESS of the fmt_addr slot: r15 + (N + 3)
MOV r1, 3
ADD r3, r1, r2
ADD r15, r2, r2
MOV r4, [r2]
MOV r8, 1
SUB r15, r8, r9
MOV [r9], r4
; next arg slot address = (fmt_addr slot address) - 1; decrements per vararg fetched
MOV r1, 1
SUB r2, r1, r4
MOV r8, 3
SUB r15, r8, r9
MOV [r9], r4
; video cursor starts at VIDEO_BASE
MOV r4, 61696
MOV r8, 2
SUB r15, r8, r9
MOV [r9], r4
L_printf_loop_1:
MOV r8, 1
SUB r15, r8, r9
MOV r5, [r9]
MOV r6, [r5]
MOV r1, 0
CMP r6, r1
JE L_printf_done_2
